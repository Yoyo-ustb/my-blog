---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About Me"
	description="A little bit about me."
	pubDate={new Date('August 08 2021')}
	heroImage={AboutHeroImage}
>
	<p>
		Hi, I'm Yoyo. I'm a developer who enjoys building things for the web and learning something
		new every day.
	</p>

	<p>
		I started this blog to document what I learn, share projects I'm working on, and keep a record
		of my progress along the way.
	</p>

	<p>
		You can find my code on <a href="https://github.com/Yoyo-ustb">GitHub</a>.
	</p>

	<p>
		You can find my articles and photos on <a href="/wechat">WeChat Official Account</a>.
	</p>
</Layout>
