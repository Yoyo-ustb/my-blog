---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Yoyo 👋</h1>
			<p>
				Welcome to my corner of the internet. This is where I write about code, things I'm
				learning, and whatever else is on my mind.
			</p>
			<p>
				Start with the <a href="/blog">latest posts</a>, learn more <a href="/about">about me</a>,
				or check out my projects on <a href="https://github.com/Yoyo-ustb">GitHub</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
